# Configure these as Elastic Beanstalk environment properties.
# Do not upload a real .env in the deployment ZIP.
IMAGE_TAG=replace-with-published-commit-sha
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/sevasignal
CLIENT_ORIGIN=https://sevasignal.example.com
# Optional fictional hackathon data. Disabled unless explicitly enabled.
ENABLE_DEMO_SEED=false
# When enabled, set a unique password of at least 12 characters in Beanstalk.
# Use the literal password, not a URL-encoded value. Never commit a real password.
DEMO_PASSWORD=
