# The embedded mode is a persistent, local PostgreSQL engine (PGlite).
# No separate database installation is needed for the local demo.
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_MODE=embedded
EMBEDDED_DATA_DIR=.data/sevasignal

# To use a separately installed PostgreSQL server, set DATABASE_MODE=postgres.
DATABASE_URL=postgresql://sevasignal:change-me@localhost:5432/sevasignal
DATABASE_SSL=false
# Optional path to a trusted CA certificate if DATABASE_SSL=true.
DATABASE_CA_FILE=

SESSION_TTL_HOURS=8
DEFAULT_STATUS_TTL_MINUTES=60
SHOW_DEMO_HELP=true
# Production demo seeding is opt-in. Keep disabled unless preparing fictional data.
ENABLE_DEMO_SEED=false
# Local sample-account password. In production, explicitly set a unique value
# of at least 12 characters in AWS; never use or commit a real password here.
DEMO_PASSWORD=SevaDemo2026!
